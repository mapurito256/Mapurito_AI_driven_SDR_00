{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": ["Bash", "Edit", "Write", "WebFetch", "WebSearch"],
    "deny": [
      "Edit(/.agents/**)", "Edit(/.claude/**)", "Edit(/.opencode/**)", "Edit(/.mapurito/**)", "Edit(/.git/**)",
      "Edit(/AGENTS.md)", "Edit(/CLAUDE.md)", "Edit(/pipeline-layout/**)",
      "Edit(/define-problem/**)", "Edit(/specify-requirements/**)", "Edit(/resolve-architecture-v2/**)", "Edit(/compile-build-package-v2/**)",
      "Edit(/inputs/**)", "Read(**/evals/**)", "Read(**/legacy/**)", "Agent"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.agents/mapurito/runtime/claude-hook.mjs\" || exit 2" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Read|Skill",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.agents/mapurito/runtime/claude-hook.mjs\" || exit 2" }]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "mapurito-claude",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.agents/mapurito/runtime/claude-hook.mjs\" || exit 2" }]
      }
    ]
  }
}
